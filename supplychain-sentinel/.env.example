# ─── SupplyChain Sentinel — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is listed in .gitignore.

# ── Backend server ────────────────────────────────────────────────────────────
PORT=4000

# ── IBM watsonx.ai configuration ─────────────────────────────────────────────
#
# IBM_CLOUD_API_KEY
#   Your IBM Cloud API key.
#   Get one at: https://cloud.ibm.com → Manage → Access (IAM) → API keys
#   Leave as "mock" (or remove the line) to run in offline mock mode.
#
IBM_CLOUD_API_KEY=mock

#
# WATSONX_BASE_URL
#   The OpenAI-compatible model gateway base URL for your IBM Cloud region.
#   Format: https://<region>.ml.cloud.ibm.com/ml/gateway/v1
#
#   Common regions:
#     Dallas    → https://us-south.ml.cloud.ibm.com/ml/gateway/v1
#     Frankfurt → https://eu-de.ml.cloud.ibm.com/ml/gateway/v1
#     London    → https://eu-gb.ml.cloud.ibm.com/ml/gateway/v1
#     Tokyo     → https://jp-tok.ml.cloud.ibm.com/ml/gateway/v1
#
#   Source: IBM watsonx.ai docs — "Inferencing models through the model gateway"
#
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/gateway/v1

#
# AI_MODEL
#   The watsonx.ai model ID to use for chat completions.
#   Default: ibm/granite-3-3-8b-instruct
#     - IBM Granite 3.3 8B Instruct
#     - Available on multitenant hardware (no deployment required)
#     - Confirmed active as of April 2025
#     - Replaces the withdrawn ibm/granite-13b-chat-v2
#
AI_MODEL=ibm/granite-3-3-8b-instruct
