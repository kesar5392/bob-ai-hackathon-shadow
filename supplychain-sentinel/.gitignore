# ─── SupplyChain Sentinel .gitignore ─────────────────────────────────────────

# Environment variables — NEVER commit this file.
# It contains IBM API keys and other secrets.
.env

# Node.js dependencies — install with `npm install` instead.
node_modules/
backend/node_modules/
frontend/node_modules/

# Vite / build output
frontend/dist/
frontend/.vite/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
